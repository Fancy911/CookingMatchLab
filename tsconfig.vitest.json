{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  "include": [
    "assets/game/scripts/domain/cp0b/**/*.ts",
    "assets/game/scripts/application/cp0c/**/*.ts",
    "tools/cp0b/**/*.ts",
    "tests/**/*.ts"
  ]
}
